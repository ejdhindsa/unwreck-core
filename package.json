{
  "name": "unwreck-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "dev": "pnpm -r --parallel --filter './packages/*' dev",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:pkg": "pnpm -r --filter './packages/*' exec publint && pnpm -r --filter './packages/*' exec attw --pack .",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm check:pkg",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.27.0",
    "culori": "^4.0.1",
    "lefthook": "^1.10.0",
    "publint": "^0.3.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
